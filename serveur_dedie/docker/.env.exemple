# Copie ce fichier en « .env » (même dossier) pour choisir toi-même, puis : docker compose up -d
# Tout le reste (monde, randomizer, mode Hanteurs, joueurs max, deathlink, difficulté, mot de passe de partie) se
# règle depuis le lanceur : Héberger › « Sur mon serveur dédié » › « Administrer le serveur ».

# Port TCP ouvert sur le serveur (et redirigé par la box)
WWMP_PORT=7777

# Compte admin du serveur (distinct du mot de passe de partie). Vide = créé au hasard au premier démarrage, écrit
# dans le volume (docker compose exec wwmp cat /donnees/admin.txt) et affiché une fois dans le journal.
# Rempli ici, il l'emporte sur admin.txt tant qu'il y est.
WWMP_ADMIN_UTILISATEUR=admin
WWMP_ADMIN_MOT_DE_PASSE=

# Mot de passe de la partie au PREMIER démarrage seulement (vide = créé au hasard dans le volume :
# docker compose exec wwmp cat /donnees/mot_de_passe.txt). Ensuite, il se change dans le lanceur.
WWMP_MOT_DE_PASSE=

# Utilisateur (UID / GID) qui fait tourner le serveur dans le conteneur, jamais root. 10001 par défaut. Pour en changer
# sur un volume existant : docker compose run --rm --user 0 --entrypoint chown wwmp -R UID:GID /donnees
WWMP_UID=10001
WWMP_GID=10001
